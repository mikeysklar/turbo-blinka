# Real frame rates on a panel for the vectorio travel box fix
# Pi Zero 2 W, Adafruit PiTFT ILI9341 320x240, fourwire at 24 MHz, 12 s per run
# step 6 px: every shape overlaps the box it just left, so the fix cannot engage
# step 160 px: further than any of the three shapes, which is the case it is for
#
#   cd ~/blinka-turbo && PYTHONPATH=<snap>:. ~/env/bin/python3 \
#       vector_demo.py --display ili9341 --seconds 12 --step <step>

